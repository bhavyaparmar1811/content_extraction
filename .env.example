# ==============================================================================
# SOP Migration System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values: cp .env.example .env

# ==============================================================================
# 1. LLM Provider API Keys
# ==============================================================================
# Google Gemini API Key (used when SOP_LLM_PLANNER_MODEL / SOP_LLM_SUMMARIZER_MODEL starts with "gemini/")
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OpenAI API Key (used when SOP_LLM_PLANNER_MODEL / SOP_LLM_SUMMARIZER_MODEL starts with "openai/")
OPENAI_API_KEY=

# Anthropic Claude API Key (used when SOP_LLM_PLANNER_MODEL / SOP_LLM_SUMMARIZER_MODEL starts with "anthropic/")
ANTHROPIC_API_KEY=

# Azure OpenAI API Key (used when Azure routing is on, see section 2)
AZURE_OPENAI_API_KEY=


# ==============================================================================
# 2. Azure OpenAI Configuration (Optional)
# ==============================================================================
# Azure routing turns on automatically when an endpoint and AZURE_OPENAI_API_KEY are set.
# Set SOP_USE_AZURE_OPENAI=true/false to force it either way.
# The standard Azure names work too: AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_VERSION and
# AZURE_OPENAI_DEPLOYMENT_NAME (one deployment for both planner and summarizer).
# The SOP_ names below win when both are set.
# SOP_USE_AZURE_OPENAI=
SOP_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
SOP_AZURE_OPENAI_API_VERSION=2024-12-01-preview
SOP_AZURE_OPENAI_PLANNER_DEPLOYMENT=gpt-4o
SOP_AZURE_OPENAI_SUMMARIZER_DEPLOYMENT=gpt-4o-mini


# ==============================================================================
# 3. LLM Model & Generation Settings
# ==============================================================================
# Mode A (programmatic summarization) vs Mode B (LLM semantic summarization)
SOP_USE_LLM_SECTION_SUMMARIZER=false

# Default model strings (format: provider/model-name, e.g., gemini/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-3-5-sonnet-20241022)
SOP_LLM_PLANNER_MODEL=gemini/gemini-2.5-flash
SOP_LLM_SUMMARIZER_MODEL=gemini/gemini-2.5-flash

SOP_LLM_TEMPERATURE=0.1
SOP_LLM_PLANNER_MAX_TOKENS=16384
SOP_LLM_SUMMARIZER_MAX_TOKENS=4096

# Rate Limiting & Retry
SOP_LLM_MAX_CONCURRENT=3
SOP_LLM_MIN_DELAY_SECONDS=0.5
SOP_LLM_MAX_RETRIES=5
SOP_LLM_BASE_BACKOFF_SECONDS=2.0


# ==============================================================================
# 4. Processing & OCR Settings
# ==============================================================================
SOP_MAX_UPLOAD_SIZE_MB=50
SOP_OCR_ENABLED=false
SOP_OCR_LANGUAGE=eng

# Semantic chunking & embeddings
SOP_EMBEDDING_MODEL=all-MiniLM-L6-v2
SOP_SIMILARITY_THRESHOLD=0.4

# Table stitching
SOP_TABLE_STITCH_ENABLED=true
SOP_TABLE_STITCH_SCORE_THRESHOLD=0.7
SOP_TABLE_STITCH_COLUMN_TOLERANCE_PT=15.0
SOP_TABLE_STITCH_BOTTOM_ZONE_PCT=0.75
SOP_TABLE_STITCH_TOP_ZONE_PCT=0.20

# Logging
SOP_LOG_LEVEL=INFO
SOP_LOG_DIR=data/logs

# Migration
SOP_SKIP_PREAMBLE_MIGRATION=true


# ==============================================================================
# 5. Directory Paths (Optional overrides, relative to project root)
# ==============================================================================
# SOP_UPLOAD_DIR=data/uploads
# SOP_EXTRACTED_IMAGES_DIR=data/extracted_images
# SOP_EXTRACTED_ICONS_DIR=data/extracted_icons
# SOP_TEMP_DIR=data/temp
# SOP_OUTPUT_DIR=data/output
# SOP_MIGRATION_OUTPUT_DIR=data/migrated
# SOP_MIGRATION_TEMPLATE_DIR=data/templates
